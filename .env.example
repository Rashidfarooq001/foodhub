# Environment Configuration Example for FoodHub Ecosystem

# Backend Configuration
PORT=4000
NODE_ENV=development
APP_NAME=FoodHub-Backend
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://foodhub_user:foodhub_pass@localhost:5432/foodhub_db?schema=public

# Redis & Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-foodhub-2026-enterprise
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=super-secret-refresh-key-foodhub-2026
REFRESH_TOKEN_EXPIRATION=7d

# SMS & Messaging Gateway (MSG91)
MSG91_AUTH_KEY=mock_msg91_key
MSG91_SENDER_ID=FOODHB
MSG91_TEMPLATE_ID=mock_template

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_mockKey123
RAZORPAY_KEY_SECRET=mockRazorpaySecret123

# Cloud Storage (Cloudflare R2)
R2_ACCOUNT_ID=mock_account_id
R2_ACCESS_KEY_ID=mock_access_key
R2_SECRET_ACCESS_KEY=mock_secret_key
R2_BUCKET_NAME=foodhub-assets
R2_PUBLIC_URL=https://assets.foodhub.local

# Firebase Cloud Messaging
FCM_SERVER_KEY=mock_fcm_server_key

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_CUSTOMER_WEB_URL=http://localhost:3000
NEXT_PUBLIC_HOTEL_DASHBOARD_URL=http://localhost:3001
NEXT_PUBLIC_DELIVERY_DASHBOARD_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_DASHBOARD_URL=http://localhost:3003
