# Database Connection (CockroachDB/PostgreSQL)
# IMPORTANT: Use a DIFFERENT database for local development than production!
DATABASE_URL=postgresql://user:password@localhost:26257/foodhub_dev

# Redis Connection (Required for Socket.io & rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Configuration
PORT=4000
NODE_ENV=development

# Security Keys (Generate unique values for production)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Third-party Services
RAZORPAY_KEY_ID=placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret
MSG91_AUTH_KEY=placeholder_msg91_auth
MSG91_WIDGET_ID=placeholder_msg91_widget
MSG91_SENDER_ID=FOODHB
MAPPLS_API_KEY=placeholder_mappls_key
