model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  action     AuditAction
  entityName String      @map("entity_name")
  entityId   String      @map("entity_id")
  oldValue   Json?       @map("old_value")
  newValue   Json?       @map("new_value")
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityName, entityId])
  @@map("audit_logs")
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  isEnabled   Boolean  @default(false) @map("is_enabled")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model APIKey {
  id        String    @id @default(uuid()) @db.Uuid
  keyHash   String    @unique @map("key_hash")
  client    String
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("api_keys")
}

model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  event     String
  url       String
  secret    String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("webhooks")
}

model PricingConfig {
  id                          String    @id @default(uuid()) @db.Uuid
  restaurantCommissionPercent Decimal?  @map("restaurant_commission_percent") @db.Decimal(5, 2)
  customerDeliveryPerKm       Decimal   @default(0.00) @map("customer_delivery_per_km") @db.Decimal(10, 2)
  minimumCustomerDeliveryFee  Decimal   @default(15.00) @map("minimum_customer_delivery_fee") @db.Decimal(10, 2)
  platformFee                 Decimal   @default(3.00) @map("platform_fee") @db.Decimal(10, 2)
  smallOrderThreshold         Decimal   @default(0.00) @map("small_order_threshold") @db.Decimal(10, 2)
  smallOrderFee               Decimal   @default(0.00) @map("small_order_fee") @db.Decimal(10, 2)
  riderBasePay                Decimal   @default(25.00) @map("rider_base_pay") @db.Decimal(10, 2)
  riderPerKmPay               Decimal   @default(6.00) @map("rider_per_km_pay") @db.Decimal(10, 2)
  riderWaitingPay             Decimal   @default(0.00) @map("rider_waiting_pay") @db.Decimal(10, 2)
  riderPeakBonus              Decimal   @default(0.00) @map("rider_peak_bonus") @db.Decimal(10, 2)
  riderLongDistanceBonus      Decimal   @default(0.00) @map("rider_long_distance_bonus") @db.Decimal(10, 2)
  riderBatchBonus             Decimal   @default(0.00) @map("rider_batch_bonus") @db.Decimal(10, 2)
  paymentGatewayPlanningRate  Decimal   @default(2.00) @map("payment_gateway_planning_rate") @db.Decimal(5, 2)
  effectiveFrom               DateTime  @default(now()) @map("effective_from")
  effectiveUntil              DateTime? @map("effective_until")
  createdBy                   String?   @map("created_by")
  updatedBy                   String?   @map("updated_by")
  isDefault                   Boolean   @default(true) @map("is_default")
  createdAt                   DateTime  @default(now()) @map("created_at")
