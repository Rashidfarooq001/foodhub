model PricingConfigAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  configId      String   @map("config_id") @db.Uuid
  changedBy     String   @map("changed_by")
  previousValue Json     @map("previous_value")
  newValue      Json     @map("new_value")
