model TaxRule {
  id                    String    @id @default(uuid()) @db.Uuid
  code                  String    @unique // e.g. RESTAURANT_FOOD_SERVICE, PLATFORM_FEE, SMALL_ORDER_FEE, DELIVERY_SERVICE, RESTAURANT_COMMISSION, PAYMENT_GATEWAY, RIDER_TIP
  name                  String
  componentType         String    @map("component_type") // FOOD, PLATFORM_FEE, SMALL_ORDER_FEE, DELIVERY, COMMISSION, GATEWAY, TIP
  taxCategory           String    @map("tax_category") // ECO_SECTION_9_5, SERVICE_TAX, MERCHANT_SERVICE, PASS_THROUGH, FINANCIAL_COST
  sacCode               String?   @map("sac_code")
  rate                  Decimal   @default(0.00) @db.Decimal(5, 2)
  cgstRate              Decimal   @default(0.00) @map("cgst_rate") @db.Decimal(5, 2)
  sgstRate              Decimal   @default(0.00) @map("sgst_rate") @db.Decimal(5, 2)
  utgstRate             Decimal   @default(0.00) @map("utgst_rate") @db.Decimal(5, 2)
  igstRate              Decimal   @default(0.00) @map("igst_rate") @db.Decimal(5, 2)
  supplierType          String    @default("ECO_FOODHUB") @map("supplier_type")
  recipientType         String    @default("CUSTOMER") @map("recipient_type")
  placeOfSupplyRule     String    @default("LOCATION_OF_RESTAURANT") @map("place_of_supply_rule")
  sectionReference      String?   @map("section_reference")
  notificationReference String?   @map("notification_reference")
  legalReference        String?   @map("legal_reference")
  notes                 String?
  effectiveFrom         DateTime  @default(now()) @map("effective_from")
  effectiveTill         DateTime? @map("effective_till")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("tax_rules")
}

model TaxRuleAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  taxRuleId      String   @map("tax_rule_id") @db.Uuid
  changedBy      String   @map("changed_by")
  previousValue  Json     @map("previous_value")
  newValue       Json     @map("new_value")
  reason         String?
  legalReference String?  @map("legal_reference")
  timestamp      DateTime @default(now())

  @@map("tax_rule_audit_logs")
}

// ==========================================
// MODULE 22: DATA PROTECTION & PRIVACY (DPDP ACT 2023 / 2025)
// ==========================================

enum PrivacyConsentType {
  TERMS_AND_CONDITIONS
  PRIVACY_POLICY
  TERMS_AND_PRIVACY_NOTICE
  MARKETING_COMMUNICATIONS
  LOCATION_DATA_PROCESSING
  ORDER_NOTIFICATIONS
  ANALYTICS_COOKIES
}

enum PrivacyRequestType {
  DATA_ACCESS
  DATA_CORRECTION
  DATA_DELETION
  CONSENT_WITHDRAWAL
}

enum PrivacyRequestStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum ComplaintCategory {
  PRIVACY_CONCERN
  INCORRECT_DATA
  UNAUTHORIZED_ACCESS
  LOCATION_TRACKING
  UNAUTHORIZED_SHARING
  ACCOUNT_SECURITY
  OTHER
}

enum ComplaintStatus {
  RECEIVED
  UNDER_INVESTIGATION
  RESOLVED
  REJECTED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  DETECTED
  INVESTIGATING
  CONTAINED
  REMEDIATING
  NOTIFICATION_REQUIRED
  NOTIFICATION_COMPLETED
  RESOLVED
  CLOSED
}

model PrivacyConsent {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  consentType PrivacyConsentType @map("consent_type")
  policyName  String?            @map("policy_name")
  purpose     String
  version     String             @default("1.0")
  granted     Boolean            @default(true)
  grantedAt   DateTime           @default(now()) @map("granted_at")
  acceptedAt  DateTime?          @default(now()) @map("accepted_at")
  withdrawnAt DateTime?          @map("withdrawn_at")
  source      String             @default("CUSTOMER_REGISTRATION")
  ipAddress   String?            @map("ip_address")
  userAgent   String?            @map("user_agent")
  requestId   String?            @map("request_id")
  metadata    Json?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentType, version])
  @@index([userId])
  @@index([consentType])
  @@index([version])
  @@index([acceptedAt])
  @@index([source])
  @@index([createdAt])
  @@map("privacy_consents")
}

model LegalPolicyVersion {
  id          String             @id @default(uuid()) @db.Uuid
  policyType  PrivacyConsentType @map("policy_type")
  policyName  String             @map("policy_name")
  version     String             @default("1.0")
  status      String             @default("ACTIVE")
  content     String?            @db.Text
  summary     String?
  publishedAt DateTime           @default(now()) @map("published_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@unique([policyType, version])
  @@index([policyType])
  @@index([status])
  @@map("legal_policy_versions")
}

model PrivacyRequest {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  type            PrivacyRequestType
  status          PrivacyRequestStatus @default(PENDING)
  reason          String?
  requestedData   Json?                @map("requested_data")
  correctionData  Json?                @map("correction_data")
  responsePayload Json?                @map("response_payload")
  rejectionReason String?              @map("rejection_reason")
  assignedTo      String?              @map("assigned_to") @db.Uuid
  requestedAt     DateTime             @default(now()) @map("requested_at")
  verifiedAt      DateTime?            @map("verified_at")
  completedAt     DateTime?            @map("completed_at")
  rejectedAt      DateTime?            @map("rejected_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("privacy_requests")
}

model PrivacyComplaint {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String?           @map("user_id") @db.Uuid
  name         String
  email        String
  phone        String?
  orderNumber  String?           @map("order_number")
  category     ComplaintCategory @default(PRIVACY_CONCERN)
  subject      String
  description  String            @db.Text
  evidenceUrls Json?             @map("evidence_urls")
  status       ComplaintStatus   @default(RECEIVED)
  priority     TicketPriority    @default(MEDIUM)
  assignedTo   String?           @map("assigned_to") @db.Uuid
  resolution   String?           @db.Text
  resolvedAt   DateTime?         @map("resolved_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([category])
  @@map("privacy_complaints")
}

model DataBreachIncident {
  id                   String           @id @default(uuid()) @db.Uuid
  incidentTitle        String           @map("incident_title")
  incidentType         String           @map("incident_type")
  severity             IncidentSeverity @default(LOW)
  status               IncidentStatus   @default(DETECTED)
  detectedAt           DateTime         @default(now()) @map("detected_at")
  containedAt          DateTime?        @map("contained_at")
  resolvedAt           DateTime?        @map("resolved_at")
  affectedRecordsCount Int              @default(0) @map("affected_records_count")
  affectedSystems      String[]         @default([]) @map("affected_systems")
  description          String           @db.Text
  mitigationSteps      String?          @map("mitigation_steps") @db.Text
  notificationRequired Boolean          @default(false) @map("notification_required")
  notifiedAt           DateTime?        @map("notified_at")
  dpbiNotified         Boolean          @default(false) @map("dpbi_notified")
  assignedAdminId      String?          @map("assigned_admin_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@index([severity])
  @@map("data_breach_incidents")
}

model PrivacyAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  actorRole String?  @map("actor_role")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  requestId String?  @map("request_id")
  metadata  Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("privacy_audit_logs")
}

model DataRetentionPolicy {
  id            String    @id @default(uuid()) @db.Uuid
  category      String    @unique
  description   String
  retentionDays Int       @map("retention_days")
  legalBasis    String    @map("legal_basis")
  isAuditable   Boolean   @default(true) @map("is_auditable")
  lastCleanedAt DateTime? @map("last_cleaned_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("data_retention_policies")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
