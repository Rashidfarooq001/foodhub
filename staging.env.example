# ===================================================
# ZaykaFood Staging Environment Variables Template
# ===================================================
# NEVER commit real secrets to Git.
# Copy this file to staging.env and fill in real values.
# staging.env is listed in .gitignore.

# ── Application ─────────────────────────────────
NODE_ENV=staging
PORT=4000
# Unique per container — set by docker-compose or k8s downward API
API_INSTANCE_ID=api-1
# Role: api | socket | worker
NODE_ROLE=api
LOG_LEVEL=info

# ── Database ─────────────────────────────────────
# CockroachDB staging connection string
# Example for Cockroach Serverless:
#   postgresql://zayka_user:PASSWORD@cluster.cockroachdb.com:26257/zaykafood?sslmode=verify-full
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/zaykafood?sslmode=require

# Prisma connection pool
# Start at 5 per instance; max total = 5 × num_api_instances
# For 4 API + 4 Socket + 1 Worker = 9 instances → 45 max connections
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT=10
DATABASE_QUERY_TIMEOUT=15000

# ── Redis ─────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# For TLS-enabled managed Redis (e.g. ElastiCache, Upstash):
# REDIS_TLS=true
# REDIS_URL=rediss://USER:PASSWORD@HOST:6380

# ── JWT ───────────────────────────────────────────
# Must be identical across ALL backend instances
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── CORS ──────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://zaykafood.online,https://hotel.zaykafood.online,https://admin.zaykafood.online,https://rider.zaykafood.online

# ── Razorpay ─────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_SECRET
# Webhook secret for server-side signature verification
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# ── MSG91 (OTP) ───────────────────────────────────
MSG91_API_KEY=REPLACE_WITH_MSG91_API_KEY
MSG91_TEMPLATE_ID=REPLACE_WITH_TEMPLATE_ID
MSG91_WIDGET_ID=REPLACE_WITH_WIDGET_ID
MSG91_WIDGET_TOKEN=REPLACE_WITH_WIDGET_TOKEN

# ── Mappls (Maps) ─────────────────────────────────
MAPPLS_API_KEY=REPLACE_WITH_MAPPLS_KEY
MAPPLS_CLIENT_ID=REPLACE_WITH_MAPPLS_CLIENT_ID
MAPPLS_CLIENT_SECRET=REPLACE_WITH_MAPPLS_CLIENT_SECRET

# ── Admin Bootstrap ────────────────────────────────
# Override the admin phone used during initial setup.
# Remove after first admin account is created.
ADMIN_PHONE_OVERRIDE=+910000000000

# ── Firebase (optional push notifications) ────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── AWS S3 (optional file uploads) ───────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
