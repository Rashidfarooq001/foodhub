{
  "name": "foodhub-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "FoodHub Enterprise Multi-Restaurant Food Delivery Platform Monorepo",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build --filter=!backend",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo type-check",
    "test": "turbo test",
    "clean": "turbo clean && rimraf node_modules",
    "docker:dev": "docker-compose -f docker/docker-compose.yml up --build",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "validate": "turbo run typecheck build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.10.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lighthouse": "^13.4.1",
    "lint-staged": "^15.2.11",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "puppeteer": "^25.10.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  }
}